{
  "name": "@qoretechnologies/reqraft",
  "version": "0.10.16",
  "description": "ReQraft is a collection of React components and hooks that are used across Qore Technologies' products made using the ReQore component library from Qore.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "source": "source ~/.profile",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:ci": "vitest run --project unit --reporter=json --outputFile=tests.json",
    "test:stories": "vitest run --project storybook",
    "precheck": "yarn run lint && yarn run test && yarn build:test:prod",
    "build": "./node_modules/typescript/bin/tsc --project tsconfig.prod.json",
    "build:test": "./node_modules/typescript/bin/tsc --noEmit",
    "build:test:prod": "./node_modules/typescript/bin/tsc --project tsconfig.prod.json --noEmit",
    "lint": "yarn run eslint ./src/",
    "start": "yarn storybook",
    "storybook": "storybook dev -p 6008",
    "update-reqore": "yarn add -D @qoretechnologies/reqore@beta",
    "update-qlip": "yarn add @qoretechnologies/qlip@beta --dev",
    "update-toolkit": "yarn add @qoretechnologies/ts-toolkit@beta",
    "install-playwright": "npx playwright@latest install --with-deps",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "yalc:push": "yarn build && yalc push",
    "yalc:watch": "tsc-watch --project tsconfig.prod.json --onSuccess \"yalc push\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qoretechnologies/toolkit-react.git"
  },
  "keywords": [
    "library",
    "ui",
    "react",
    "toolkit",
    "qore",
    "qorus"
  ],
  "pre-push": [
    "build:test:prod",
    "lint",
    "test"
  ],
  "author": {
    "name": "Qore Technologies"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/qoretechnologies/toolkit-react/issues"
  },
  "homepage": "https://github.com/qoretechnologies/toolkit-react#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@netsells/storybook-mockdate": "^0.3.3",
    "@qoretechnologies/qlip": "^0.1.3-beta.20260622084321",
    "@qoretechnologies/reqore": "^0.71.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.14.166",
    "@types/node": "^14.14.14",
    "@types/react": "^18.3.1",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "^18.3.0",
    "@types/react-query": "^1.2.9",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "chromatic": "^11.3.0",
    "eslint": "^8.46.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-storybook": "10.4.6",
    "jsdom": "^29.1.1",
    "mock-socket": "^9.3.1",
    "npm-cli-login": "^0.1.1",
    "playwright": "^1.60.0",
    "pre-push": "^0.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.4.2",
    "react-test-renderer": "^18.2.0",
    "storybook": "^10.4.6",
    "storybook-addon-mock": "^6.0.1",
    "ts-node": "^9.1.1",
    "tsc-watch": "^7.2.0",
    "type-fest": "^4.18.2",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@qoretechnologies/reqore": ">=0.68.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@qoretechnologies/ts-toolkit": "^0.5.80",
    "@tanstack/react-query": "4",
    "classnames": "^2.2.6",
    "cron-validator": "^1.4.0",
    "cronstrue": "^2.50.0",
    "epoch-timeago": "^1.1.9",
    "filesize": "^10.1.6",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21",
    "nanoid": "^5.1.5",
    "polished": "^4.2.2",
    "react-color": "^2.19.3",
    "react-dropzone": "^14.3.5",
    "react-markdown": "^9.0.1",
    "react-use": "^17.6.0",
    "scheduler": "^0.23.0",
    "style-to-object": "^1.0.0",
    "styled-components": "^5.3.6",
    "thenby": "^1.3.4",
    "use-context-selector": "^2.0.0",
    "zustand": "^5.0.3"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  }
}
